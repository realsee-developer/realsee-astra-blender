* text=auto
*.py text eol=lf
*.md text eol=lf
*.txt text eol=lf
*.json text eol=lf
*.yml text eol=lf
*.jpg binary
*.png binary
artifacts/*.blend filter=lfs diff=lfs merge=lfs -text
artifacts/*.usdz filter=lfs diff=lfs merge=lfs -text
artifacts/*.mp4 filter=lfs diff=lfs merge=lfs -text
artifacts/*.glb filter=lfs diff=lfs merge=lfs -text

# Original case exports; human-readable dataset metadata stays in ordinary Git.
data/** filter=lfs diff=lfs merge=lfs -text
data/README*.md !filter !diff !merge text eol=lf
data/manifest.json !filter !diff !merge text eol=lf
data/SHA256SUMS !filter !diff !merge text eol=lf
